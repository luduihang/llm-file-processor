# 本地 vLLM：Qwen3.8-27B-W4A16-AutoRound（案例笔记用大输出预算）
# case_study prompt 输出需求大（完整问答 + 九个章节），max_tokens 提高到 8192
LLM_BASE_URL=http://192.168.0.190:8001/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen3.8-27B-W4A16-AutoRound
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8192
LLM_RETRIES=3
# 关闭 Qwen3.8 思考模式（思考文本会挤占输出预算）
LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
