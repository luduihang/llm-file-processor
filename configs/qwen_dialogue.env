# 杨炎国学对话还原专用配置
# 本地 vLLM（8001，W4A16 量化版，max_model_len 32768）
# 对话稿输出 ≈ 输入等长，max_tokens 比 case 型（8192）更大
LLM_BASE_URL=http://192.168.0.190:8001/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen3.8-27B-W4A16-AutoRound
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=12288
LLM_RETRIES=3
# Qwen3 思考模式会把思考过程混进 content，必须显式关掉
LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# 长生成防超时（OpenAI 客户端默认 600s 在高并发下不够）
LLM_TIMEOUT=1800
