# 本地 vLLM：Qwen3.8-27B-W4A16-AutoRound（A100x2 docker）
LLM_BASE_URL=http://192.168.0.190:8001/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen3.8-27B-W4A16-AutoRound
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_RETRIES=3
# 关闭 Qwen3.8 思考模式（思考文本会挤占输出预算）
LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# 长生成防超时（OpenAI 客户端默认 600s 在高并发下不够）
LLM_TIMEOUT=1800
