# 模型配置示例：复制为 .env（默认）或 configs/<名字>.env 后填写
# 必填
LLM_BASE_URL=http://192.168.0.190:8001/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen3.8-27B-W4A16-AutoRound
# 可选（有默认值：0.7 / 4096 / 3 / {}）
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_RETRIES=3
# 可选：JSON 对象，直通到 API 请求体。vLLM 思考模型关思考示例：
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
